{
  "_readme": "qq-bridge 配置示例。把 <> 里的内容换成你自己的，共 8 处：dsh.baseUrl 的端口、snowluma.accessToken、snowluma.launcherPath/homeDir、ownerQQ、sessionCwd、allow、consoleToken。socialV2.memory / mood / rotate 三段是本项目新增的可调参数，默认值就是调过的。注意：改配置不要直接改文件后重启（会被内存副本覆盖），要走 POST /api/socialV2/config。",
  "dsh": {
    "baseUrl": "http://127.0.0.1:50000",
    "provider": "deepseek-account",
    "model": "deepseek-flash",
    "reasoningEffort": "high",
    "authToken": "",
    "authHeader": "authorization",
    "authPrefix": "Bearer",
    "allowRemote": false
  },
  "snowluma": {
    "wsUrl": "ws://127.0.0.1:3001",
    "httpUrl": "http://127.0.0.1:3000",
    "accessToken": "<SnowLuma 的 accessToken>",
    "followDiscoveredEndpoint": true,
    "silenceWarnMs": 600000,
    "launcherPath": "C:\\path\\to\\deepseek-harness\\default-workspace\\qq群聊助手\\SnowLuma",
    "homeDir": "C:\\path\\to\\deepseek-harness\\default-workspace\\qq群聊助手\\SnowLuma"
  },
  "ownerQQ": 100000001,
  "sessionCwd": "C:\\path\\to\\deepseek-harness\\default-workspace",
  "agentPreset": "qq-chat",
  "workspaceTitle": "QQ 聊天",
  "allow": {
